{
  "yaml.schemas": {
    "./.vscode/schemas/grafana-datasource-schema.json": [
      "docker/grafana/provisioning/datasources/*.yml"
    ]
  },
  "python.defaultInterpreterPath": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
  "python.analysis.extraPaths": [
    "${workspaceFolder}/backend",
    "${workspaceFolder}/sdk/python",
    "${workspaceFolder}/cli",
    "${workspaceFolder}/.venv/Lib/site-packages"
  ],
  "python.autoComplete.extraPaths": [
    "${workspaceFolder}/backend",
    "${workspaceFolder}/sdk/python",
    "${workspaceFolder}/cli",
    "${workspaceFolder}/.venv/Lib/site-packages"
  ],
  "pyrefly.extraSearchPaths": [
    "${workspaceFolder}/backend",
    "${workspaceFolder}/sdk/python",
    "${workspaceFolder}/cli",
    "${workspaceFolder}/.venv/Lib/site-packages"
  ],
  "java.configuration.updateBuildConfiguration": "automatic",
  "python.analysis.include": ["backend"],
  "python.analysis.exclude": [
    "**/__pyrefly_virtual__/**",
    "C:/__pyrefly_virtual__/**",
    "c:/__pyrefly_virtual__/**"
  ],
  "python.analysis.ignore": [
    "**/__pyrefly_virtual__/**",
    "C:/__pyrefly_virtual__/**",
    "c:/__pyrefly_virtual__/**"
  ],
  "files.watcherExclude": {
    "**/__pyrefly_virtual__/**": true,
    "C:/__pyrefly_virtual__/**": true,
    "c:/__pyrefly_virtual__/**": true
  },
  "files.exclude": {
    "**/__pyrefly_virtual__/**": true,
    "C:/__pyrefly_virtual__/**": true,
    "c:/__pyrefly_virtual__/**": true
  },
  "css.lint.unknownAtRules": "ignore"
}
