{
  "include": ["backend", "sdk/python", "cli"],
  "extraPaths": ["backend", "sdk/python", "cli"],
  "venvPath": ".",
  "venv": ".venv",
  "exclude": [
    "**/node_modules",
    "**/__pycache__",
    "**/.venv",
    "**/__pyrefly_virtual__/**",
    "**/inmemory/**"
  ],
  "ignore": ["**/__pyrefly_virtual__/**", "**/inmemory/**"]
}
