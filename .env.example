# ==============================================================================
# EVALFORGE ROOT ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to '.env' for local Docker Compose development, or set these
# variables in your deployment platform (Vercel for Frontend, Render/Railway for Backend).

# ------------------------------------------------------------------------------
# Core Application Configuration
# ------------------------------------------------------------------------------
# Application Environment: 'development' (default for local clone), 'testing', or 'production'
APP_ENV=development

# Application Name
APP_NAME=EvalForge API

# Enable Debugging: Set to 'False' in production
DEBUG=True

# API Route Prefix
API_V1_STR=/api/v1

# Backend Port
PORT=8000

# ------------------------------------------------------------------------------
# Database Configuration (PostgreSQL)
# ------------------------------------------------------------------------------
# For local Docker Compose / local Postgres:
DATABASE_URL=postgresql+asyncpg://postgres:postgres_password@localhost:5432/evalforge

# Discrete parameters used if DATABASE_URL is not set:
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password
POSTGRES_DB=evalforge

# ------------------------------------------------------------------------------
# Redis Cache & Queue Configuration
# ------------------------------------------------------------------------------
# For local Docker Compose / local Redis:
REDIS_URL=redis://localhost:6379/0

# Fallback parameters used if REDIS_URL is not set:
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ------------------------------------------------------------------------------
# Security & Access Control
# ------------------------------------------------------------------------------
# Secret Key for JWT / Encryption (In production: generate a 64-character random hex string)
SECRET_KEY=dev-secret-key-evalforge-placeholder

# Allowed CORS Origins (JSON array of trusted frontend URLs)
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://localhost:80", "https://eval-forge-sandy.vercel.app"]

# Allowed Host Headers
ALLOWED_HOSTS=["*"]

# ------------------------------------------------------------------------------
# Structured Logging
# ------------------------------------------------------------------------------
# Minimum Logging Level: 'debug', 'info', 'warning', 'error', 'critical'
LOG_LEVEL=info

# Format logs as structured JSON (Set to True for cloud collectors / production)
JSON_LOGS=False

# ------------------------------------------------------------------------------
# Frontend Settings
# ------------------------------------------------------------------------------
# Public API URL endpoint accessed by client applications
VITE_API_URL=http://localhost:8000/api/v1

# ------------------------------------------------------------------------------
# LLM Provider API Keys (Optional - Provided per-evaluation or environment-wide)
# ------------------------------------------------------------------------------
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
COHERE_API_KEY=
NVIDIA_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# ------------------------------------------------------------------------------
# Google OAuth 2.0 / OpenID Connect Authentication
# ------------------------------------------------------------------------------
# Backend Google Client credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
FRONTEND_URL=http://localhost:5173
