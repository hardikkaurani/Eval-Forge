# ==============================================================================
# EVALIUM PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to '.env' for local development or set these variables in your
# deployment platform (Vercel for Frontend, Render for Backend & Services).

# ------------------------------------------------------------------------------
# Core Application Configuration
# ------------------------------------------------------------------------------
# Application Environment: 'development', 'testing', or 'production'
APP_ENV=production

# Application Name
APP_NAME=Evalium API

# Enable Debugging: MUST be 'False' in production
DEBUG=False

# API Route Prefix
API_V1_STR=/api/v1

# Backend Port (Render sets PORT automatically)
PORT=8000

# ------------------------------------------------------------------------------
# Database Configuration (Render Managed PostgreSQL)
# ------------------------------------------------------------------------------
# Database URL (Render provides DATABASE_URL; postgres:// or postgresql:// scheme is automatically converted to postgresql+asyncpg://)
DATABASE_URL=postgresql://postgres:your_secure_database_password_placeholder@dpg-evalforge-db.oregon-postgres.render.com/evalforge

# PostgreSQL Fallback Parameters (used if DATABASE_URL is not set)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_database_password_placeholder
POSTGRES_DB=evalforge

# ------------------------------------------------------------------------------
# Redis Cache & Queue Configuration (Render Managed Redis / Valkey)
# ------------------------------------------------------------------------------
# Redis URL (Render provides REDIS_URL)
REDIS_URL=rediss://default:your_secure_redis_password_placeholder@red-evalforge.oregon-redis.render.com:6379

# Redis Fallback Parameters (used if REDIS_URL is not set)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ------------------------------------------------------------------------------
# Security & Access Control
# ------------------------------------------------------------------------------
# Secret Key for JWT / Encryption (Generate a secure 64-char random hex string)
SECRET_KEY=change-this-in-production-to-a-secure-random-64-character-hex-string

# Allowed CORS Origins (JSON array or comma-separated list of trusted frontend URLs)
CORS_ORIGINS=["https://evalforge.onrender.com", "https://eval-forge-sandy.vercel.app"]

# Allowed Host Headers for Host Header Attack protection
ALLOWED_HOSTS=["*"]

# ------------------------------------------------------------------------------
# Structured Logging
# ------------------------------------------------------------------------------
# Minimum Logging Level: 'debug', 'info', 'warning', 'error', 'critical'
LOG_LEVEL=info

# Format logs as structured JSON (Recommended for production log collectors)
JSON_LOGS=True

# ------------------------------------------------------------------------------
# Frontend Settings (Vercel Environment Variables)
# ------------------------------------------------------------------------------
# Public API URL endpoint accessed by client applications
VITE_API_URL=https://evalforge.onrender.com/api/v1

# ------------------------------------------------------------------------------
# LLM Provider API Keys (Optional - Provided per-evaluation or environment-wide)
# ------------------------------------------------------------------------------
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
COHERE_API_KEY=
NVIDIA_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# ------------------------------------------------------------------------------
# Stripe SaaS Billing Configuration (Optional)
# ------------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# ------------------------------------------------------------------------------
# Google OAuth 2.0 / OpenID Connect Authentication
# ------------------------------------------------------------------------------
# Backend Google Client credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://evalforge.onrender.com/api/v1/auth/google/callback
FRONTEND_URL=https://eval-forge-sandy.vercel.app
