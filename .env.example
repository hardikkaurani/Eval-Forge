# ==============================================================================
# EVALFORGE PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to '.env' for local development or set these variables in your
# deployment platform (Vercel for Frontend, Railway for Backend & Services).

# ------------------------------------------------------------------------------
# Core Application Configuration
# ------------------------------------------------------------------------------
# Application Environment: 'development', 'testing', or 'production'
APP_ENV=production

# Application Name
APP_NAME=EvalForge API

# Enable Debugging: MUST be 'False' in production
DEBUG=False

# API Route Prefix
API_V1_STR=/api/v1

# Backend Port (Railway sets PORT automatically)
PORT=8000

# ------------------------------------------------------------------------------
# Database Configuration (Railway PostgreSQL)
# ------------------------------------------------------------------------------
# Database URL (Railway provides DATABASE_URL; postgres:// or postgresql:// scheme is automatically converted to postgresql+asyncpg://)
DATABASE_URL=postgresql://postgres:secure_production_password@db.evalforge.internal:5432/evalforge

# PostgreSQL Fallback Parameters (used if DATABASE_URL is not set)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=secure_production_password
POSTGRES_DB=evalforge

# ------------------------------------------------------------------------------
# Redis Cache & Queue Configuration (Railway Redis)
# ------------------------------------------------------------------------------
# Redis URL (Railway provides REDIS_URL or REDIS_PRIVATE_URL)
REDIS_URL=redis://redis.evalforge.internal:6379/0

# Redis Fallback Parameters (used if REDIS_URL is not set)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ------------------------------------------------------------------------------
# Security & Access Control
# ------------------------------------------------------------------------------
# Secret Key for JWT / Encryption (Generate a secure 64-char random hex string)
SECRET_KEY=change-this-in-production-to-a-secure-random-64-character-hex-string

# Allowed CORS Origins (JSON array or comma-separated list of trusted frontend URLs)
# Example: ["https://evalforge.vercel.app"]
CORS_ORIGINS=["https://evalforge.vercel.app"]

# Allowed Host Headers for Host Header Attack protection
# Example: ["evalforge-backend.up.railway.app", "localhost"]
ALLOWED_HOSTS=["*"]

# ------------------------------------------------------------------------------
# Structured Logging
# ------------------------------------------------------------------------------
# Minimum Logging Level: 'debug', 'info', 'warning', 'error', 'critical'
LOG_LEVEL=info

# Format logs as structured JSON (Recommended for production log collectors)
JSON_LOGS=True

# ------------------------------------------------------------------------------
# Frontend Settings (Vercel Environment Variables)
# ------------------------------------------------------------------------------
# Public API URL endpoint accessed by client applications
VITE_API_URL=https://evalforge-backend.up.railway.app/api/v1

# ------------------------------------------------------------------------------
# LLM Provider API Keys (Optional - Provided per-evaluation or environment-wide)
# ------------------------------------------------------------------------------
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
COHERE_API_KEY=
NVIDIA_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
