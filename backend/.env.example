# ==============================================================================
# EvalForge Backend Environment Template
# ==============================================================================
# Copy this file to 'backend/.env' for local backend development.
#
# Environment Modes:
#   - 'development': Enables OpenAPI docs (/docs, /redoc), permissive CORS, debug logs.
#   - 'testing': Used during automated test runs.
#   - 'production': Strict security checks enforced (DEBUG=False, non-default SECRET_KEY, secure DB password).

# ------------------------------------------------------------------------------
# Core Application Configuration
# ------------------------------------------------------------------------------
APP_ENV=development
APP_NAME=EvalForge API
DEBUG=True
PORT=8000
API_V1_STR=/api/v1

# ------------------------------------------------------------------------------
# Database Configuration (PostgreSQL)
# ------------------------------------------------------------------------------
# For local Docker: postgres is exposed on localhost:5432 (user: postgres, pass: postgres_password)
# If DATABASE_URL is set, it overrides the separate POSTGRES_* variables.
DATABASE_URL=postgresql+asyncpg://postgres:postgres_password@localhost:5432/evalforge
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password
POSTGRES_DB=evalforge

# ------------------------------------------------------------------------------
# Redis Cache & Background Queue
# ------------------------------------------------------------------------------
# For local Docker: redis is exposed on localhost:6379
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ------------------------------------------------------------------------------
# Security & Access Control
# ------------------------------------------------------------------------------
# In development, a placeholder is permitted. In production, provide a 64-char random hex string.
SECRET_KEY=dev-secret-key-evalforge-placeholder
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://localhost:80", "https://eval-forge-sandy.vercel.app"]
ALLOWED_HOSTS=["*"]

# ------------------------------------------------------------------------------
# Logging
# ------------------------------------------------------------------------------
LOG_LEVEL=info
JSON_LOGS=False

# ------------------------------------------------------------------------------
# LLM Providers (Optional - configured per-evaluation or platform-wide)
# ------------------------------------------------------------------------------
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
COHERE_API_KEY=
NVIDIA_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
