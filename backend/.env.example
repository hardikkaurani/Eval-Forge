# Backend Environment Variable Template
APP_ENV=production
APP_NAME=Evalium API
DEBUG=False
PORT=8000
API_V1_STR=/api/v1

# Database Configuration (Render Managed PostgreSQL)
DATABASE_URL=postgresql://postgres:your_secure_database_password_placeholder@dpg-evalforge-db.oregon-postgres.render.com/evalforge
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_database_password_placeholder
POSTGRES_DB=evalforge

# Redis Configuration (Render Managed Redis / Valkey)
REDIS_URL=rediss://default:your_secure_redis_password_placeholder@red-evalforge.oregon-redis.render.com:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Security Configuration
SECRET_KEY=change-this-in-production-to-a-secure-random-64-character-hex-string
CORS_ORIGINS=["https://evalforge.onrender.com", "https://eval-forge-sandy.vercel.app"]
ALLOWED_HOSTS=["*"]

# Logging
LOG_LEVEL=info
JSON_LOGS=True

# LLM Providers (Optional)
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Stripe Billing (Optional)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# Google OAuth 2.0 / OpenID Connect (Production & Local)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://evalforge.onrender.com/api/v1/auth/google/callback
FRONTEND_URL=https://eval-forge-sandy.vercel.app
