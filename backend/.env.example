# Backend Environment Variable Template
APP_ENV=production
APP_NAME=EvalForge API
DEBUG=False
PORT=8000
API_V1_STR=/api/v1

# Database Configuration (Railway / PostgreSQL)
DATABASE_URL=postgresql://postgres:secure_password@db.evalforge.internal:5432/evalforge
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password
POSTGRES_DB=evalforge

# Redis Configuration (Railway / Redis)
REDIS_URL=redis://redis.evalforge.internal:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Security Configuration
SECRET_KEY=change-this-in-production-to-a-secure-random-64-character-hex-string
CORS_ORIGINS=["https://evalforge.vercel.app"]
ALLOWED_HOSTS=["*"]

# Logging
LOG_LEVEL=info
JSON_LOGS=True

# LLM Providers (Optional)
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
